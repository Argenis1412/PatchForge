{
  "allowed_path_patterns": [
    "pyproject.toml",
    "uv.lock",
    "CHANGELOG.md",
    "docs/context/Workflow.md"
  ],
  "allowed_operations": [
    {
      "pattern": "pyproject.toml",
      "operations": ["modify"]
    },
    {
      "pattern": "uv.lock",
